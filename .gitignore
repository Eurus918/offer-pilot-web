# 依赖
node_modules/

# 环境变量（含 API Key，绝不提交）
.env
.env.local

# 真实数据（含个人投递记录、简历信息，绝不提交）
# 模板与演示数据是要提交的，只排除使用者自己的那份
data/store.json
data/store.json.*
data/store.json.tmp
data/store.json.corrupt-*

# 演示模式运行时数据（云端实例跑示例数据时的可写副本，由 store.demo.json 生成）
data/demo.runtime.json
data/demo.runtime.json.*

# 使用者的私有知识库（从 agent-kb.example 生成，含个人信息）
# 模板 agent-kb.example/ 会被提交
agent-kb/

# 日志
*.log
server.log

# 系统文件
.DS_Store
Thumbs.db
